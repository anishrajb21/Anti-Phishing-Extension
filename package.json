{
  "name": "phishlens-sentinel",
  "version": "1.1.0",
  "description": "On-device real-time phishing detection browser extension for Chromium (Manifest V3)",
  "type": "module",
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:security": "node --test tests/security/*.test.js",
    "test:ml": "python -m pytest ml/tests/ -v",
    "test:all": "npm run test && npm run test:ml",
    "ml:train": "python ml/train_model.py",
    "ml:eval": "python ml/evaluate_model.py"
  },
  "keywords": [
    "anti-phishing",
    "cybersecurity",
    "browser-extension",
    "manifest-v3",
    "machine-learning"
  ],
  "author": "PhishLens Security Team",
  "license": "Apache-2.0"
}
